<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="CustomFieldSorting.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CustomFieldSorting"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:kanban="using:Syncfusion.UI.Xaml.Kanban"
    mc:Ignorable="d"
    Title="CustomFieldSorting">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="0.85*"/>
        </Grid.RowDefinitions>

        <Grid.DataContext>
            <local:KanbanViewModel/>
        </Grid.DataContext>

        <!-- Top controls -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Spacing="15"
                    Padding="5"
                    Margin="10,0,0,0">
            <TextBlock Text="Sort direction:"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
            <ComboBox x:Name="sortOrderCombobox"
                      SelectedIndex="0"
                      Width="200"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      SelectionChanged="OnSortOrderSelectionChanged">
            </ComboBox>

            <TextBlock Text="Sorting mapping path:"
                       Margin="10,0,0,0"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
            <ComboBox x:Name="mappingPathCombobox"
                      SelectedIndex="0"
                      Width="200"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      SelectionChanged="OnMappingPathSelectionChanged">
            </ComboBox>
        </StackPanel>

        <!-- Kanban -->
        <kanban:SfKanban x:Name="kanban"
                         Grid.Row="1"
                         ColumnWidth="300"
                         ItemsSource="{Binding Cards}"
                         ColumnMappingPath="Category"
                         SortingMappingPath="Title"
                         SortingOrder="Ascending">

            <kanban:SfKanban.CardTemplate>
                <DataTemplate>
                    <Border BorderBrush="Black"
                            BorderThickness="1"
                            CornerRadius="8"
                            Background="#F3CFCE"
                            Padding="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Priority (• {Priority}) -->
                            <StackPanel Grid.Row="0"
                                        Grid.ColumnSpan="2"
                                        Orientation="Horizontal"
                                        Spacing="4"
                                        VerticalAlignment="Center"
                                        Height="20">
                                <!-- Using Inlines as an alternative to StringFormat -->
                                <TextBlock FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="Orange"
                                           VerticalAlignment="Center">
                                    <Run Text="• "/>
                                    <Run Text="{Binding Priority}"/>
                                </TextBlock>
                            </StackPanel>

                            <!-- Title -->
                            <TextBlock Grid.Row="1"
                                       Grid.ColumnSpan="2"
                                       Text="{Binding Title}"
                                       FontWeight="Bold"
                                       FontSize="14"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       Margin="5"/>

                            <!-- Description -->
                            <TextBlock Grid.Row="2"
                                       Grid.ColumnSpan="2"
                                       Text="{Binding Description}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       HorizontalAlignment="Left"
                                       Margin="5"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </kanban:SfKanban.CardTemplate>

            <!-- Columns -->
            <kanban:KanbanColumn HeaderText="Open" Categories="Open"/>
            <kanban:KanbanColumn HeaderText="In Progress" Categories="In Progress"/>
            <kanban:KanbanColumn HeaderText="Done" Categories="Done"/>
        </kanban:SfKanban>
    </Grid>
</Window>
